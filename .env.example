# Supabase public/server configuration
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_URL="https://your-project-id.supabase.co"

# Server-only. Never expose this value through VITE_* variables or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=""

# Client-side Supabase configuration injected by Vite
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Mercado Pago server-only credentials
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""

# Google Calendar OAuth (server-only; never prefix with VITE_)
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:3000/api/google-calendar/callback"
GOOGLE_CALENDAR_STATE_SECRET=""
GOOGLE_CALENDAR_TOKEN_SECRET=""
